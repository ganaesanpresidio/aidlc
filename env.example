# Template for local secrets. Create your own copy:  cp env.example .env
# .env is git-ignored, and Claude Code is denied access to it (.claude/settings.json).
# Never put real values in this template.

# ── AWS (dev account only) ───────────────────────────────
# Use SSO profiles (aws configure sso). Do NOT put access keys here.
AWS_PROFILE=aidlc-dev
AWS_REGION=us-east-1

# ── Alerts (DEP-02 Notification hook) ────────────────────
# Incoming-webhook URL for the team alert channel (Slack/Teams). Secret.
AIDLC_ALERT_WEBHOOK=

# ── Atlassian / Jira (DIS-01/DIS-02) ─────────────────────
# Read by tools/aidlc_e2e/config.py. Claude's Jira access signs in with OAuth via /mcp,
# so no password is needed for that. JIRA_API_TOKEN is only for scripts that call the
# Jira REST API directly — create one at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v1/mcp
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_CLOUD_ID=
JIRA_PROJECT_KEY=
JIRA_EPIC_KEY=
JIRA_EMAIL=
JIRA_API_TOKEN=
CONFLUENCE_SPACE_KEY=
